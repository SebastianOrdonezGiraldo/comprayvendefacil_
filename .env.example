# Copie este archivo a .env y ajuste los valores.

# Aplicación: usuario SIN permiso para saltarse la separación por empresa (lo crea `pnpm db:migrar`).
DATABASE_URL=postgres://cvf_app:clave-local-app@localhost:5432/comprayvendefacil
# Dueño de las tablas: solo para migraciones.
DATABASE_ADMIN_URL=postgres://cvf_admin:clave-local@localhost:5432/comprayvendefacil

REDIS_URL=redis://localhost:6379

# Genere uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambie-esto-por-un-secreto-de-32-caracteres-o-mas
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:5173
PUERTO=3000
