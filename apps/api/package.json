{
  "name": "@cvf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tipos": "./src/tipos.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/servidor.ts",
    "build": "tsup",
    "start": "node dist/servidor.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=../../.env src/nucleo/migrar-cli.ts"
  },
  "dependencies": {
    "@cvf/compartido": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
